* s02_utils.do - Path and helper definitions

program define get_paths
    global base_path ".."
    global raw_data "$base_path/data/raw"
    global interim_data "$base_path/data/interim"
    global processed_data "$base_path/data/processed"
    global figures_path "$base_path/results/figures"
end

program define ensure_dir
    syntax varname
    quietly mkdir ``varlist''
end

