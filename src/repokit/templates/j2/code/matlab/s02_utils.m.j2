function paths = get_paths()
    % Get absolute paths to project directories
    here = mfilename('fullpath');
    root = fileparts(here);
    paths.base = root;
    paths.raw = fullfile(root, 'data', 'raw');
    paths.interim = fullfile(root, 'data', 'interim');
    paths.processed = fullfile(root, 'data', 'processed');
    paths.figures = fullfile(root, 'results', 'figures');
end
